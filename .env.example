# Copy to `.env` for local development (`.env` is gitignored).
# In production, set these in the deployment platform's dashboard instead.

# Supabase project settings (Project Settings -> API). The app talks to the
# database through the Supabase Python client, so it needs the project URL and
# an API key. Prefer the service-role key for server-side use; an anon key also
# works with the policies in supabase/migrations.
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key

# OpenRouter (https://openrouter.ai/keys) - optional; without it the translator
# falls back to the free MyMemory API.
OPENROUTER_API_KEY=your_openrout_url
OPENROUTER_MODEL=your_model
